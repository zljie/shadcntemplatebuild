# Copy to .env.local (git-ignored) and fill in. Restart `npm run dev` after changes.

# ── LLM for the in-editor AI assistant (src/llm) ──
LLM_PROVIDER=deepseek            # deepseek | openai-compatible | mock
DEEPSEEK_API_KEY=                # https://platform.deepseek.com/api_keys
DEEPSEEK_MODEL=deepseek-flash    # or deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_THINKING=true              # default state of the "深度思考" switch

# Any other OpenAI-compatible vendor (Qwen/DashScope, Moonshot, Zhipu, OpenAI, vLLM, Ollama…)
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=
# LLM_MODEL=qwen-plus
# LLM_JSON_MODE=true

# ── MCP over HTTP (/api/mcp) and shadcn registry (/r/*.json) ──
# MCP_TOKEN=                     # require "Authorization: Bearer <token>" on /api/mcp (set for any non-local deployment)
# REGISTRY_BASE_URL=             # public origin used in registry URLs (defaults to the request origin)
# TEMPLATES_DIR=./templates      # template library location
