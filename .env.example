# Copy to .env.local (git-ignored) and fill in. Restart `npm run dev` after changes.

# ── LLM for the in-editor AI assistant (src/llm) ──
LLM_PROVIDER=deepseek            # deepseek | openai-compatible | mock
DEEPSEEK_API_KEY=                # https://platform.deepseek.com/api_keys
DEEPSEEK_MODEL=deepseek-flash    # or deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_THINKING=true              # default state of the "深度思考" switch
# AI_BUSINESS_CONTEXT=           # default business context (brand, industry, tone) when the AI panel sends none; also returned by MCP get_page_protocol

# Any other OpenAI-compatible vendor (Qwen/DashScope, Moonshot, Zhipu, OpenAI, vLLM, Ollama…)
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=
# LLM_MODEL=qwen-plus
# LLM_JSON_MODE=true

# ── MCP over HTTP (/api/mcp) and shadcn registry (/r/*.json) ──
# MCP_TOKEN=                     # require "Authorization: Bearer <token>" on /api/mcp (set for any non-local deployment)
# REGISTRY_BASE_URL=             # public origin used in registry URLs (defaults to the request origin)
# TEMPLATES_DIR=./templates      # template library location

# ── opc-platform (OAF-005) backend for 发布中心 / 数据映射 / Operation 目录 / 能力试运行 ──
# Pages reach these only through the server-side proxy /api/opc/<service>/…; unset = pages show「未配置」.
OPC_META_DATA_URL=http://127.0.0.1:4100
OPC_DB_CONNECT_URL=http://127.0.0.1:4200
OPC_BFF_URL=http://127.0.0.1:4000
OPC_APP=campus-library-librarian
# Development identity only (needs the BFF to run with OPC_DEV_IDENTITY=1): forward x-opc-actor / x-opc-roles.
OPC_DEV_IDENTITY=1
# Identity used when a page does not pick one (e.g. /apps prototypes with business commands)
OPC_DEV_ACTOR=u_librarian
OPC_DEV_ROLES=LIBRARIAN
